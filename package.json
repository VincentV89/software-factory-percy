{
  "name": "percy",
  "private": true,
  "version": "0.1.0",
  "description": "Percy 2 MVP: core email send path (Platform, ContactSG, Campaign Engine, Integrations)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm run test && npm run arch && npm run test:infra && npm run synth && npm run secrets",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:infra": "vitest run -c apps/infra/vitest.config.ts",
    "arch": "depcruise packages apps --config .dependency-cruiser.cjs",
    "synth": "npm run synth -w @percy/infra",
    "secrets": "secretlint \"**/*\"",
    "spa:build": "npm run build -w @percy/spa",
    "local": "tsx apps/local/src/server.ts",
    "e2e:local": "playwright test -c tests/e2e/playwright.local.config.ts",
    "e2e:dev": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1171.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1171.0",
    "@aws-sdk/client-dynamodb": "^3.1171.0",
    "@aws-sdk/client-firehose": "^3.1171.0",
    "@aws-sdk/client-lambda": "^3.1171.0",
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/client-scheduler": "^3.1171.0",
    "@aws-sdk/client-secrets-manager": "^3.1171.0",
    "@aws-sdk/client-sesv2": "^3.1171.0",
    "@aws-sdk/client-sfn": "^3.1171.0",
    "@aws-sdk/client-sqs": "^3.1171.0",
    "@aws-sdk/client-ssm": "^3.1171.0",
    "@aws-sdk/lib-dynamodb": "^3.1171.0",
    "@aws-sdk/s3-presigned-post": "^3.1171.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "csv-parse": "^5.6.0",
    "jose": "^6.2.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "sanitize-html": "^2.18.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "eslint": "^9.39.5",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.73.0",
    "globals": "^16.5.0",
    "vitest": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^17.4.3",
    "secretlint": "^14.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "tsx": "^4.23.15",
    "aws-cdk": "^2.1148.1",
    "aws-cdk-lib": "^2.277.0",
    "constructs": "^10.8.1",
    "cdk-nag": "^2.38.2",
    "esbuild": "^0.28.2",
    "@playwright/test": "^1.65.1",
    "aws-sdk-client-mock": "^4.1.0",
    "vite": "^7.3.8",
    "@vitejs/plugin-react": "^5.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/node": "^22.19.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/aws-lambda": "^8.10.164"
  }
}
